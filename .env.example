# ── LinkPulse (Node API) environment ──────────────────────────────
# Copy to server/.env for local development:  cp .env.example server/.env
# Never commit a real .env file.

# PostgreSQL connection string (local Postgres, Neon, Supabase Postgres, Render Postgres, …)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkpulse
# Set to true for hosted databases that require TLS (Neon, Supabase, Render external URL)
DATABASE_SSL=false
# true = also verify the database's TLS certificate (use when your host's certificate is signed by a public CA; Supabase direct connections need their CA, so leave false there)
DATABASE_SSL_STRICT=false

# Port the API listens on
PORT=4000
# Public base URL that short codes are appended to (your deployed domain in production)
SHORT_BASE_URL=http://localhost:4000
# Origin of the web app (dev: Vite on 5173; production: same as SHORT_BASE_URL)
APP_ORIGIN=http://localhost:5173

# Sessions
SESSION_TTL_DAYS=14
# true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# bcrypt cost factor for account and link passwords (12 recommended; tests use 4)
BCRYPT_COST=12
# Number of reverse proxies in front of the app (Render/Railway/Fly: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=false

# ── Safety ──
# Optional: Google Safe Browsing v4 API key (https://developers.google.com/safe-browsing/v4/get-started)
# Leave empty to disable; links are then labelled "URL format valid" (reputation not checked).
GOOGLE_SAFE_BROWSING_API_KEY=
# Comma-separated domains to block (subdomains are blocked too). Rows in the blocked_domains table also apply.
BLOCKLIST_DOMAINS=

# Production only: set to false to skip running migrations on start
# RUN_MIGRATIONS_ON_START=true

# ── Email: account verification + password reset ──
# console = print emails to the server log (development only; nothing is printed in production)
# resend  = deliver through https://resend.com (set RESEND_API_KEY and a verified EMAIL_FROM)
# smtp    = any SMTP server, no extra package (set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
EMAIL_PROVIDER=console
EMAIL_FROM=LinkPulse <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587          # 465 = TLS from the start; anything else upgrades with STARTTLS (credentials are never sent unencrypted)
SMTP_USER=
SMTP_PASS=
# Block link creation until the email is confirmed. Defaults to true only when EMAIL_PROVIDER=resend.
# REQUIRE_EMAIL_VERIFICATION=true
# Private sign-up: the form answers "check your email" for new AND already-registered addresses, and no session starts
# until the email is confirmed, so it can't be used to find out who has an account. Defaults to true with resend/smtp.
# PRIVATE_SIGNUP=true
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60

# ── Scaling ──
# Where rate-limit counters live: "postgres" (shared by all instances, default) or "memory" (single instance).
RATE_LIMIT_STORE=postgres
# Seconds-scale cache of link rows on the redirect path (milliseconds; 0 turns it off).
LINK_CACHE_TTL_MS=5000
